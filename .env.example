# Copy this file to .env and fill it in. Never commit .env.

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Optional: your server's ID. Slash commands show up instantly in that server
# (without it they're registered globally, which can take a little while the first time).
DISCORD_GUILD_ID=
# Optional: channel ID for match updates. You can also just run /setchannel in Discord.
NOTIFY_CHANNEL_ID=

# --- Stats sources (set at least one; both = everything) ---------------------
# A Ubisoft account the bot logs in with (use a spare account WITHOUT 2-step verification).
# Gives: rank, RP, K/D, wins/losses/abandons per playlist, level, playtime, commendations.
UBISOFT_EMAIL=
UBISOFT_PASSWORD=
# Free API key from https://r6.arenyze.com (needed for per-operator stats).
ARENYZE_API_KEY=

# --- Tracking ----------------------------------------------------------------
# Who to track, comma separated. Platform after a colon: pc (default), psn or xbox.
TRACK_PLAYERS=Ludvig
# How often to check for new matches (minutes, minimum 1).
POLL_INTERVAL_MINUTES=5
# No new match for this long = the play session is over (a summary gets posted).
SESSION_GAP_MINUTES=45
# How often to refresh operator stats when nothing is happening (they're always
# refreshed right after new matches).
OPERATOR_REFRESH_MINUTES=60
# Used for "today", dates in messages and charts.
TIMEZONE=Europe/Stockholm
# Where the database and Ubisoft session cache live.
DATA_DIR=data
